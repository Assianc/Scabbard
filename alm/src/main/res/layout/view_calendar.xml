<?xml version="1.0" encoding="utf-8"?>
<!--
  历史记录页里的系统 CalendarView。
  保留原因：CalendarView 的 dateTextAppearance / weekDayTextAppearance / theme 只能在 XML 里声明
  （没有对应的运行时 setter），所以这里用一份最小布局承载它，经 AndroidView 挂进 Compose。
-->
<CalendarView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calendarView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/gradient_background_rili"
    android:dateTextAppearance="@style/CalendarDateText"
    android:weekDayTextAppearance="@style/CalendarWeekText"
    android:theme="@style/CalendarViewTheme" />
