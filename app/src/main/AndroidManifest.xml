<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.assiance.scabbard"
    tools:ignore="SelectedPhotoAccess">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ScabbardApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/scabbard14"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/scabbard14"
        android:supportsRtl="true"
        android:theme="@style/Theme.Scabbard"
        tools:targetApi="33">

        <!--
            全 App 唯一的 Activity，承载 NavHost。
            改造前这里是 StartSplashActivity / StartActivity / MainActivity / AboutActivity /
            AppearanceActivity / PlayerSelectionActivity 六个，外加 memo、alm 两个模块各自的 Activity。

            launchMode="singleTop"：alm 的闹钟通知会带路由 extra 打回来（见 AlmHostNavigation），
            singleTop 让 Intent 落到已有实例上，路由 push 到现有返回栈，看完闹钟按返回能退回原来那页。
        -->
        <activity
            android:name=".ScabbardActivity"
            android:exported="true"
            android:launchMode="singleTop" />

        <!--
            App Icon Aliases —— 15 个。
            ★ 别名名字一个都没动：IconManager 是按别名名字启停组件的，而别名名字又存进了
              老用户的 app_settings.current_icon，改名会让已有用户的图标设置失效。
              变的只有 targetActivity（.StartSplashActivity → .ScabbardActivity）。
        -->
        <activity-alias
            android:name=".MainActivity.Default"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/scabbard14"
            android:label="@string/app_name"
            android:targetActivity=".ScabbardActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

